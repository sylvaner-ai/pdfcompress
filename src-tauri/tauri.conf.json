{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Compress",
  "version": "0.1.0",
  "identifier": "fr.sylvainrobert.pdfcompress",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PDF Compress",
        "width": 440,
        "height": 560,
        "minWidth": 360,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "contentTypes": [
          "com.adobe.pdf"
        ],
        "mimeType": "application/pdf",
        "name": "PDF",
        "role": "Viewer",
        "rank": "None"
      }
    ]
  }
}
